# Sunucuda /srv/docker/apps/hermoza/.env olarak oluşturulur (git'e girmez).

SITE_URL=https://hermoza.com.tr

# Çalışırken (container içinden, Docker ağı üzerinden)
DATABASE_URL=postgresql://hermoza:SIFRE@postgres:5432/hermoza
# Build sırasında (sunucunun kendisinden; Postgres 127.0.0.1:5432'de)
DATABASE_URL_BUILD=postgresql://hermoza:SIFRE@127.0.0.1:5432/hermoza

# Panel oturumu için en az 32 karakter rastgele değer: openssl rand -hex 32
SESSION_SECRET=

# Google Workspace SMTP (normal şifre değil, Google "Uygulama Şifresi")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@hermoza.com.tr
SMTP_PASS=
MAIL_FROM="Hermoza Kitchen & Atelier <noreply@hermoza.com.tr>"
MAIL_ADMIN_TO=info@hermoza.com.tr
